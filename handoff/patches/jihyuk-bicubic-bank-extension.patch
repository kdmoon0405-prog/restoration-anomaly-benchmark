+"""Finish metrics/provenance from a hash-verified raw extension prediction artifact."""
+from __future__ import annotations
+
+import argparse
+import csv
+import hashlib
+import json
+import os
+from pathlib import Path
+import shutil
+import tempfile
+from datetime import datetime, timezone
+
+import numpy as np
+from PIL import Image
+
+ROOT = Path(__file__).resolve().parents[1]
+import sys
+sys.path.insert(0, str(ROOT / "src"))
+
+from sr_anomaly.dataset import MVTecADFolder, safe_component
+from sr_anomaly import bank_domain_study as study
+from sr_anomaly import bicubic_bank_extension as extension
+
+
+def _canonical_sha(value):
+    data = json.dumps(value, sort_keys=True, separators=(",", ":"), ensure_ascii=False,
+                      allow_nan=False).encode("utf-8")
+    return hashlib.sha256(data).hexdigest()
+
+
+def _write_csv(path, rows):
+    fields = list(dict.fromkeys(k for row in rows for k in row))
+    with Path(path).open("w", encoding="utf-8", newline="") as stream:
+        writer = csv.DictWriter(stream, fieldnames=fields)
+        writer.writeheader()
+        writer.writerows(rows)
+
+
+def _write_npz(path, **arrays):
+    path = Path(path)
+    temporary = path.with_name(path.name + ".tmp")
+    with temporary.open("wb") as stream:
+        np.savez_compressed(stream, **arrays)
+        stream.flush()
+        os.fsync(stream.fileno())
+    temporary.replace(path)
+    return {"file": path.name, "sha256": study.sha256_file(path),
+            "arrays": {name: list(np.asarray(value).shape) for name, value in arrays.items()}}
+
+
+def _write_extension_manifest(run_dir, status, evidence_kind, files=None):
+    study.write_json_atomic(Path(run_dir) / "bank_domain_extension_manifest.json", {
+        "schema_version": extension.SCHEMA_VERSION,
+        "kind": "bicubic_bank_extension_results",
+        "family": extension.EXTENSION_FAMILY,
+        "status": status,
+        "evidence_kind": evidence_kind,
+        "bank_domain": extension.BANK_DOMAIN,
+        "query_domains": list(extension.QUERY_DOMAINS),
+        "files": files or {},
+    })
+
+
+def _mask(sample):
+    if sample.mask_path is None:
+        return np.zeros((224, 224), dtype=bool)
+    with Image.open(sample.mask_path) as source:
+        mask = source.convert("L").resize((256, 256), Image.Resampling.NEAREST)
+        mask = mask.crop((16, 16, 240, 240))
+        result = np.asarray(mask) > 0
+    if result.shape != (224, 224):
+        raise ValueError(f"Unexpected canonical mask shape: {sample.relative_path}")
+    return result
+
+
+def _validate_raw(run_dir, state, baseline_provenance):
+    raw_path = Path(run_dir) / "raw_bicubic_x4.npz"
+    artifact = next((item for item in state.get("artifacts", [])
+                     if item.get("file") == raw_path.name), None)
+    if artifact is None or not raw_path.is_file() or study.sha256_file(raw_path) != artifact.get("sha256"):
+        raise ValueError("Saved raw prediction archive is missing or its recorded hash changed")
+    with np.load(raw_path, allow_pickle=False) as archive:
+        values = {name: archive[name].copy() for name in archive.files}
+    samples = state.get("test_samples")
+    calibration_samples = state.get("calibration_paths")
+    if (values["test_samples"].astype(str).tolist() != samples
+            or values["calibration_samples"].astype(str).tolist() != calibration_samples
+            or values["query_domains"].astype(str).tolist() != list(extension.QUERY_DOMAINS)
+            or values["bank_domain"].item() != extension.BANK_DOMAIN
+            or values["bank_sha256"].item() != state.get("bank_hash")):
+        raise ValueError("Saved raw prediction archive identity differs from status")
+    expected_shapes = {
+        "calibration_scores": (state["calibration_count"], 2),
+        "calibration_maps": (state["calibration_count"], 2, 224, 224),
+        "test_scores": (state["test_count"], 2),
+        "test_maps": (state["test_count"], 2, 224, 224),
+    }
+    for name, shape in expected_shapes.items():
+        if values[name].shape != shape or not np.isfinite(values[name]).all():
+            raise ValueError(f"Saved raw array failed shape/finite validation: {name}")
+    if int(state.get("bank_vector_count", 0)) < 1 or state.get("bank_vector_dimension") != 1024:
+        raise ValueError("Saved bank shape metadata is incomplete")
+    for field in ("query_input_sha256", "query_bicubic_sha256", "query_swinir_sha256"):
+        hashes = values[field].astype(str).tolist()
+        if len(hashes) != len(samples) or any(len(h) != 64 for h in hashes):
+            raise ValueError(f"Saved raw query hash inventory is invalid: {field}")
+    if state.get("query_manifest_sha256") != baseline_provenance.get("query_manifest_sha256"):
+        raise ValueError("Saved extension query manifest differs from the main seed-11 baseline")
+    state_inputs = state.get("test_input_sha256", {})
+    state_queries = state.get("query_rgb_sha256", {})
+    for index, sample in enumerate(samples):
+        if values["query_input_sha256"].astype(str)[index] != state_inputs.get(sample):
+            raise ValueError("Saved raw input hash differs from extension status")
+        if (values["query_bicubic_sha256"].astype(str)[index] != state_queries.get(sample, {}).get("bicubic_x4")
+                or values["query_swinir_sha256"].astype(str)[index] != state_queries.get(sample, {}).get("swinir_x4")):
+            raise ValueError("Saved raw query RGB hash differs from extension status")
+    return values, artifact
+
+
+def resume(run_dir, baseline_dir, data_root):
+    run_dir = Path(run_dir).resolve()
+    baseline_dir = Path(baseline_dir).resolve()
+    data_root = Path(data_root).resolve()
+    state_path = run_dir / "status.json"
+    state = json.loads(state_path.read_text(encoding="utf-8"))
+    if state.get("status") != "FAILED" or state.get("predictions_saved_before_gt_read") is not True:
+        raise ValueError("Resume requires a failed run with its prediction checkpoint saved before GT")
+    if state.get("category") not in ("hazelnut", "screw") or state.get("seed") != 11:
+        raise ValueError("Resume is limited to the frozen seed-11 extension")
+    if state.get("error") != "TypeError: expected str, bytes or os.PathLike object, not NoneType":
+        raise ValueError("Failure is not the known missing-normal-mask evaluation interruption")
+    if (state.get("initial_failed_status_file") != "status.failed.initial.json"
+            or not (run_dir / "status.failed.initial.json").is_file()
+            or study.sha256_file(run_dir / "status.failed.initial.json") != state.get("initial_failed_status_sha256")):
