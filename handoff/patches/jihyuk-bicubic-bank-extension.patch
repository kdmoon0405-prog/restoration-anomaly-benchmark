+        if query_inputs != baseline_provenance["query_manifest_sha256"]:
+            raise ValueError("Query manifest changed between prediction and saved provenance")
+        # Only now read test GT/mask bytes.
+        test_mask_hashes = {s.relative_path.as_posix():
+            (study.sha256_file(s.mask_path) if s.mask_path else None) for s in test_samples}
+        test_labels = np.asarray([s.metadata["label"] for s in test_samples], dtype=np.uint8)
+        resize_mask = transforms.Resize(256, interpolation=InterpolationMode.NEAREST)
