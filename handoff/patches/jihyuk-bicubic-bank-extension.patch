+def _fake_run(root):
+    root.mkdir()
+    sample = "hazelnut/test/crack/000.png"
+    cal = "hazelnut/train/good/000.png"
+    raw_path = root / "raw_bicubic_x4.npz"
+    np.savez_compressed(raw_path,
+        calibration_samples=np.asarray([cal]), test_samples=np.asarray([sample]),
+        query_domains=np.asarray(extension.QUERY_DOMAINS), bank_domain=np.asarray(extension.BANK_DOMAIN),
+        bank_sha256=np.asarray("b" * 64), query_input_sha256=np.asarray(["1" * 64]),
+        query_bicubic_sha256=np.asarray(["2" * 64]), query_swinir_sha256=np.asarray(["3" * 64]),
+        calibration_scores=np.ones((1, 2), dtype=np.float64),
+        calibration_maps=np.ones((1, 2, 224, 224), dtype=np.float32),
+        test_scores=np.ones((1, 2), dtype=np.float64),
+        test_maps=np.ones((1, 2, 224, 224), dtype=np.float32))
+    exports = {}
+    for name in extension.EXPORT_FILES:
+        (root / name).write_text("synthetic fixture\n", encoding="utf-8")
+        exports[name] = study.sha256_file(root / name)
+    artifacts = [{"file": raw_path.name, "sha256": study.sha256_file(raw_path)}]
+    state = {"status": "COMPLETE", "study_family": extension.EXTENSION_FAMILY,
+        "bank_domain": extension.BANK_DOMAIN, "query_domains": list(extension.QUERY_DOMAINS),
+        "test_samples": [sample], "calibration_paths": [cal], "calibration_count": 1,
+        "test_count": 1, "bank_hash": "b" * 64, "artifacts": artifacts,
+        "evidence_kind": "synthetic_fixture", "prediction_rows": [
+            {"bank_domain": extension.BANK_DOMAIN, "query_domain": query, "sample": sample}
+            for query in extension.QUERY_DOMAINS]}
+    study.write_json_atomic(root / "status.json", state)
+    study.write_json_atomic(root / "bank_domain_extension_manifest.json", {
+        "schema_version": extension.SCHEMA_VERSION, "kind": "bicubic_bank_extension_results",
+        "family": extension.EXTENSION_FAMILY, "status": "COMPLETE",
+        "evidence_kind": "synthetic_fixture", "files": exports})
+    return root
