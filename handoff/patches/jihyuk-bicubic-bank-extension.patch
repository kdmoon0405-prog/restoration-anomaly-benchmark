+"""Contracts for the separate seed-11 Bicubic normal-bank extension."""
+from __future__ import annotations
+
+import json
+from pathlib import Path
+from typing import Any
+
+import numpy as np
+from PIL import Image
+
+from . import bank_domain_study as study
+
+EXTENSION_FAMILY = "patchcore_full_patch_bicubic_bank_extension"
+BANK_DOMAIN = "bicubic_x4"
+QUERY_DOMAINS = ("bicubic_x4", "swinir_x4")
+SCHEMA_VERSION = 1
+EXPORT_FILES = {
+    "extension_summary.csv",
+    "extension_per_image.csv",
+    "extension_query_quality.csv",
+    "config.json",
+    "provenance.json",
+}
+
+
+def make_bicubic_x4_fit_image(clean: Image.Image, *, image_size: int = 224) -> Image.Image:
+    """Apply the frozen clean -> 56px bicubic -> x4 bicubic transform."""
+    if clean.mode != "RGB" or clean.size != (image_size, image_size):
+        raise ValueError(f"Expected canonical RGB {image_size}x{image_size} input")
+    low = clean.resize((56, 56), Image.Resampling.BICUBIC)
+    return low.resize((image_size, image_size), Image.Resampling.BICUBIC)
+
+
+def _sha256(value: Any) -> bool:
+    return (isinstance(value, str) and len(value) == 64
+            and all(char in "0123456789abcdef" for char in value))
+
+
+def verify_extension_result_contract(run_dir: str | Path, *, allow_synthetic: bool = False) -> dict[str, Any]:
+    """Check the separate five-file extension export without loading raw arrays."""
+    root = Path(run_dir).resolve()
+    manifest = json.loads((root / "bank_domain_extension_manifest.json").read_text(encoding="utf-8"))
+    if (manifest.get("schema_version") != SCHEMA_VERSION
+            or manifest.get("kind") != "bicubic_bank_extension_results"
+            or manifest.get("family") != EXTENSION_FAMILY
+            or manifest.get("status") != "COMPLETE"):
+        raise ValueError("Unsupported or incomplete Bicubic-bank extension export")
+    evidence = manifest.get("evidence_kind")
+    if evidence not in ("model_predictions", "synthetic_fixture"):
+        raise ValueError("Unknown extension evidence kind")
+    if evidence == "synthetic_fixture" and not allow_synthetic:
+        raise ValueError("Synthetic fixture requires explicit opt-in")
+    files = manifest.get("files")
+    if not isinstance(files, dict) or set(files) != EXPORT_FILES:
+        raise ValueError("Extension manifest must bind exactly its five public result files")
+    for name, digest in files.items():
+        if not _sha256(digest):
+            raise ValueError(f"Invalid SHA-256 for {name}")
+        path = study.safe_artifact_path(root, name)
+        if not path.is_file() or study.sha256_file(path) != digest:
+            raise ValueError(f"Missing or changed extension export file: {name}")
+    return manifest
+
+
+def verify_extension_complete_run(run_dir: str | Path, *, allow_synthetic: bool = False) -> dict[str, Any]:
+    """Verify status order, artifact hashes, raw prediction shapes and finiteness."""
+    root = Path(run_dir).resolve()
+    state = json.loads((root / "status.json").read_text(encoding="utf-8"))
+    if (state.get("status") != "COMPLETE"
+            or state.get("study_family") != EXTENSION_FAMILY
+            or state.get("bank_domain") != BANK_DOMAIN
+            or state.get("query_domains") != list(QUERY_DOMAINS)):
+        raise ValueError("Run is not a complete supported Bicubic-bank extension")
+    evidence = state.get("evidence_kind")
+    if evidence not in ("model_predictions", "synthetic_fixture"):
+        raise ValueError("Unknown extension run evidence kind")
+    if evidence == "synthetic_fixture" and not allow_synthetic:
+        raise ValueError("Synthetic fixture requires explicit opt-in")
+    samples = state.get("test_samples")
+    if not isinstance(samples, list) or not samples or len(set(samples)) != len(samples):
+        raise ValueError("Extension test sample inventory must be ordered and unique")
+    expected = [(BANK_DOMAIN, query, sample) for query in QUERY_DOMAINS for sample in samples]
+    observed = [(row.get("bank_domain"), row.get("query_domain"), row.get("sample"))
+                for row in state.get("prediction_rows", [])]
+    if observed != expected:
+        raise ValueError("Extension bank/query/sample order differs from the frozen two-query inventory")
+    artifacts = state.get("artifacts")
+    if not isinstance(artifacts, list) or not artifacts:
+        raise ValueError("Extension has no complete artifact inventory")
+    seen: set[str] = set()
+    for item in artifacts:
+        relative = item.get("file")
+        if relative in seen:
+            raise ValueError("Duplicate extension artifact path")
+        seen.add(relative)
+        path = study.safe_artifact_path(root, relative)
+        if not path.is_file() or study.sha256_file(path) != item.get("sha256"):
+            raise ValueError(f"Missing or changed extension artifact: {relative}")
+    raw = root / "raw_bicubic_x4.npz"
+    with np.load(raw, allow_pickle=False) as values:
+        calibration_samples = values["calibration_samples"].astype(str).tolist()
+        test_samples = values["test_samples"].astype(str).tolist()
+        if test_samples != samples or values["query_domains"].astype(str).tolist() != list(QUERY_DOMAINS):
+            raise ValueError("Raw extension query/sample identity mismatch")
+        expected_shapes = {
+            "calibration_scores": (state["calibration_count"], 2),
+            "calibration_maps": (state["calibration_count"], 2, 224, 224),
+            "test_scores": (state["test_count"], 2),
+            "test_maps": (state["test_count"], 2, 224, 224),
+        }
+        for name, shape in expected_shapes.items():
+            if values[name].shape != shape or not np.isfinite(values[name]).all():
+                raise ValueError(f"Invalid extension raw array {name}: {values[name].shape}")
+        if values["bank_domain"].item() != BANK_DOMAIN:
+            raise ValueError("Raw extension bank domain mismatch")
+        if values["bank_sha256"].item() != state["bank_hash"]:
+            raise ValueError("Raw extension bank digest differs from status")
+        query_hashes = {
+            "query_input_sha256": values["query_input_sha256"].astype(str).tolist(),
+            "bicubic_x4": values["query_bicubic_sha256"].astype(str).tolist(),
+            "swinir_x4": values["query_swinir_sha256"].astype(str).tolist(),
+        }
+        if any(len(digests) != len(samples) or not all(_sha256(x) for x in digests)
+               for digests in query_hashes.values()):
+            raise ValueError("Extension query SHA inventory is incomplete")
+    if (len(calibration_samples) != state["calibration_count"]
+            or calibration_samples != state.get("calibration_paths")):
+        raise ValueError("Raw extension calibration sample inventory mismatch")
+    manifest = verify_extension_result_contract(root, allow_synthetic=allow_synthetic)
+    if manifest.get("evidence_kind") != evidence:
+        raise ValueError("Status and export evidence kinds differ")
+    return {"status": "COMPLETE", "prediction_rows": len(observed),
+            "test_samples": len(samples), "calibration_samples": len(calibration_samples),
+            "query_hashes": query_hashes, "artifacts": artifacts}
