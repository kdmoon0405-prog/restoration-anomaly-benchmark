+    state["baseline_run_id"] = baseline_provenance["run_id"]
+    study.write_status(run_dir, state)
+    _write_extension_manifest(run_dir, status="PARTIAL", evidence_kind=evidence_kind)
+    resize = transforms.Resize(256, interpolation=InterpolationMode.BILINEAR)
+    crop = transforms.CenterCrop(IMAGE_SIZE)
+    tensor = transforms.Compose([transforms.ToTensor(), transforms.Normalize(mvtec.IMAGENET_MEAN, mvtec.IMAGENET_STD)])
+    restorer = None
+    completed = False
+    try:
+        restorer = SwinIRLightweight(
+            ROOT / "third_party" / "SwinIR", checkpoint,
+            device=str(device), scale=4, tile=56, tile_overlap=0,
+        )
+        cache: dict[str, dict[str, Image.Image]] = {}
+        input_hashes: dict[str, str] = {}
+        query_hashes: dict[str, dict[str, str]] = {}
+        quality_rows: list[dict] = []
+        test_ids = {s.relative_path.as_posix() for s in test_samples}
+        for sample in calibration_samples + test_samples:
+            sample_id = sample.relative_path.as_posix()
+            clean, bicubic, restored, restoration_seconds = base._query_variants(
+                sample.path, restorer, resize, crop
+            )
+            expected_bicubic = extension.make_bicubic_x4_fit_image(clean, image_size=IMAGE_SIZE)
+            if base._rgb_sha(bicubic) != base._rgb_sha(expected_bicubic):
+                raise ValueError("Fit Bicubic transform differs from the frozen Bicubic query bytes")
+            cache[sample_id] = {"bicubic_x4": bicubic, "swinir_x4": restored}
+            input_hashes[sample_id] = branch_b._checksum(sample.path)
+            query_hashes[sample_id] = {"bicubic_x4": base._rgb_sha(bicubic), "swinir_x4": base._rgb_sha(restored)}
+            if sample_id in test_ids:
+                q_b = compute_quality_metrics(clean, bicubic, ("psnr", "ssim"))
+                q_s = compute_quality_metrics(clean, restored, ("psnr", "ssim"))
+                quality_rows.append({"sample": sample_id, "psnr_bicubic": q_b["psnr"],
+                    "ssim_bicubic": q_b["ssim"], "psnr_swinir": q_s["psnr"],
+                    "ssim_swinir": q_s["ssim"], "swinir_seconds": restoration_seconds})
+            del clean
+        if len(quality_rows) != len(test_samples):
+            raise RuntimeError("Query quality is not one row per test parent")
+        query_manifest_sha256 = _query_manifest_sha(
+            calibration_samples + test_samples, input_hashes, query_hashes
+        )
+        if query_manifest_sha256 != baseline_provenance["query_manifest_sha256"]:
+            raise ValueError("Extension query bytes differ from the existing seed-11 2x2 baseline")
+
+        train_input_hashes = {p: branch_b._checksum(data_root / p) for p in fit_paths + calibration_paths}
+        state.update({
+            "train_input_sha256": train_input_hashes,
+            "test_input_sha256": {s.relative_path.as_posix(): input_hashes[s.relative_path.as_posix()] for s in test_samples},
+            "query_rgb_sha256": query_hashes,
+            "patchcore_source_commit": actual_patchcore_commit,
+            "swinir_checkpoint_sha256": checkpoint_sha,
+            "backbone_checkpoint_sha256": backbone_sha,
+            "torch_version": torch.__version__,
+            "torchvision_version": __import__("torchvision").__version__,
+            "faiss_version": __import__("faiss").__version__,
+            "timm_version": __import__("timm").__version__,
+            "python_version": sys.version,
+            "platform": platform.platform(),
+            "torch_cuda_build": torch.version.cuda,
+            "device": str(device),
+            "gpu_name": torch.cuda.get_device_name(device),
+            "threshold_rule": "existing robust_params/normalize; per query; normal calibration only; fixed q=0.99",
+            "metric_rule": "existing evaluate_predictions; pooled AU-PRO@0.3 primary; 200 thresholds; 4-connectivity",
+            "model_configuration": {"bank_domain": extension.BANK_DOMAIN,
+                "bank_fit_transform": "clean RGB -> bicubic 56x56 -> bicubic 224x224",
+                "sampler": "IdentitySampler", "patches_per_fit_image": PATCHES_PER_IMAGE,
+                "patch_selection": "all patch rows in deterministic fit loader order",
+                "faiss": "CPU IndexFlatL2 exact 1-NN", "backbone": "WideResNet50-2 ImageNet V1",
+                "backbone_checkpoint_sha256": backbone_sha, "swinir_checkpoint_sha256": checkpoint_sha,
+                "query_domains": list(extension.QUERY_DOMAINS), "seed": args.seed},
+            "command": [sys.executable, *sys.argv],
+            "submodule_revisions": {name: branch_b.subprocess.check_output(
+                ["git", "-C", str(ROOT / "third_party" / name), "rev-parse", "HEAD"], text=True).strip()
+                for name in ("SwinIR", "patchcore-inspection")},
+            "query_manifest_sha256": query_manifest_sha256,
+        })
+        try:
+            state["nvidia_smi"] = branch_b.subprocess.check_output(
+                ["nvidia-smi", "--query-gpu=name,driver_version,memory.total", "--format=csv,noheader"], text=True
+            ).strip()
+        except Exception as error:
+            state["nvidia_smi_query_error"] = f"{type(error).__name__}: {error}"
+
+        available_before_fit = study.available_ram_bytes()
+        study.check_fit_ram(fit_plan, available_bytes=available_before_fit)
+        state["resource_snapshot_before_fit"] = {"available_ram_bytes": available_before_fit,
+            "plan": fit_plan, "disk_free_bytes": shutil.disk_usage(run_dir).free,
+            "gpu_name": torch.cuda.get_device_name(device),
+            "gpu_free_bytes_before_fit": int(torch.cuda.mem_get_info(device)[0])}
+        state["available_ram_before_bank_bytes"] = available_before_fit
+        study.write_status(run_dir, state)
+        torch.manual_seed(args.seed)
+        torch.cuda.manual_seed_all(args.seed)
+        torch.cuda.reset_peak_memory_stats(device)
+        model = base._new_patchcore(torch, backbones, common, patchcore, sampler, device, backbone_checkpoint)
+        fit_dataset = _BicubicBankDataset(train_set, fit_indices, resize, crop, tensor, torch)
+        fit_loader = torch.utils.data.DataLoader(fit_dataset, batch_size=8, shuffle=False,
+                                                 num_workers=0, pin_memory=False)
+        fit_started = time.perf_counter()
+        model.fit(fit_loader)
+        torch.cuda.synchronize(device)
+        fit_seconds = time.perf_counter() - fit_started
+        bank_values = np.asarray(model.anomaly_scorer.detection_features)
+        if (bank_values.ndim != 2 or bank_values.shape != (fit_plan["fit_vectors"], 1024)
+                or bank_values.dtype != np.float32 or not np.isfinite(bank_values).all()):
+            raise ValueError(f"Unexpected Bicubic normal bank: {bank_values.shape} {bank_values.dtype}")
+        bank_hash = study.sha256_array(bank_values)
+        bank_vector_count = int(bank_values.shape[0])
+
+        raw = {
+            "calibration_scores": np.empty((len(calibration_indices), 2), np.float64),
+            "calibration_maps": np.empty((len(calibration_indices), 2, IMAGE_SIZE, IMAGE_SIZE), np.float32),
+            "test_scores": np.empty((len(test_samples), 2), np.float64),
+            "test_maps": np.empty((len(test_samples), 2, IMAGE_SIZE, IMAGE_SIZE), np.float32),
+        }
+        inference_seconds = 0.0
+        for query_index, query_domain in enumerate(extension.QUERY_DOMAINS):
+            cal_scores, cal_maps, cal_times = base._predict_all(
+                model, tensor, cache, calibration_samples, query_domain
+            )
+            test_scores, test_maps, test_times = base._predict_all(
+                model, tensor, cache, test_samples, query_domain
+            )
+            raw["calibration_scores"][:, query_index] = cal_scores
+            raw["calibration_maps"][:, query_index] = cal_maps
+            raw["test_scores"][:, query_index] = test_scores
+            raw["test_maps"][:, query_index] = test_maps
+            inference_seconds += float(cal_times.sum() + test_times.sum())
+        raw_artifact = base._write_npz(
+            run_dir / "raw_bicubic_x4.npz",
+            bank_domain=np.asarray(extension.BANK_DOMAIN),
+            calibration_samples=np.asarray([s.relative_path.as_posix() for s in calibration_samples]),
+            test_samples=np.asarray([s.relative_path.as_posix() for s in test_samples]),
+            query_domains=np.asarray(extension.QUERY_DOMAINS),
+            bank_sha256=np.asarray(bank_hash),
+            query_input_sha256=np.asarray([input_hashes[s.relative_path.as_posix()] for s in test_samples]),
+            query_bicubic_sha256=np.asarray([query_hashes[s.relative_path.as_posix()]["bicubic_x4"] for s in test_samples]),
+            query_swinir_sha256=np.asarray([query_hashes[s.relative_path.as_posix()]["swinir_x4"] for s in test_samples]),
+            **raw,
+        )
+        state["artifacts"].append(raw_artifact)
+        state["bank_hash"] = bank_hash
+        state["bank_vector_count"] = bank_vector_count
+        state["bank_vector_dimension"] = 1024
+        state["runtime"] = {"fit_seconds": fit_seconds, "query_inference_seconds": inference_seconds,
+            "torch_cuda_peak_allocated_bytes": int(torch.cuda.max_memory_allocated(device)),
+            "torch_cuda_peak_reserved_bytes": int(torch.cuda.max_memory_reserved(device)),
+            "bank_bytes": int(bank_values.nbytes), "bank_sha256": bank_hash}
+        state["predictions_saved_before_gt_read"] = True
