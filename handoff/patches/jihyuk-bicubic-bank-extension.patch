+def test_bicubic_bank_transform_matches_frozen_query_bytes():
+    pixels = np.arange(224 * 224 * 3, dtype=np.uint32).reshape(224, 224, 3).astype(np.uint8)
+    clean = Image.fromarray(pixels, mode="RGB")
+    expected = clean.resize((56, 56), Image.Resampling.BICUBIC).resize((224, 224), Image.Resampling.BICUBIC)
+    actual = extension.make_bicubic_x4_fit_image(clean)
+    assert actual.mode == "RGB" and actual.size == (224, 224)
+    assert actual.tobytes() == expected.tobytes()
+
+
+def test_normal_test_parent_without_gt_file_gets_native_zero_mask():
+    sample = SimpleNamespace(mask_path=None, relative_path=Path("hazelnut/test/good/000.png"))
+    mask = _mask(sample)
+    assert mask.shape == (224, 224) and mask.dtype == np.bool_
+    assert not mask.any()
+
+
+def test_synthetic_extension_requires_opt_in_and_verifies_files(tmp_path):
+    root = _fake_run(tmp_path / "extension")
+    with pytest.raises(ValueError, match="Synthetic"):
+        extension.verify_extension_complete_run(root)
+    result = extension.verify_extension_complete_run(root, allow_synthetic=True)
+    assert result["status"] == "COMPLETE" and result["prediction_rows"] == 2
+
+
+def test_extension_export_hash_drift_rejected(tmp_path):
+    root = _fake_run(tmp_path / "extension")
+    with (root / "extension_summary.csv").open("a", encoding="utf-8") as stream:
+        stream.write("tampered\n")
+    with pytest.raises(ValueError, match="changed extension export"):
+        extension.verify_extension_result_contract(root, allow_synthetic=True)
+
+
+def test_raw_nonfinite_map_rejected(tmp_path):
+    root = _fake_run(tmp_path / "extension")
+    raw_path = root / "raw_bicubic_x4.npz"
+    with np.load(raw_path, allow_pickle=False) as values:
+        payload = {key: values[key] for key in values.files}
+    payload["test_maps"][0, 0, 0, 0] = np.nan
+    np.savez_compressed(raw_path, **payload)
+    state = json.loads((root / "status.json").read_text(encoding="utf-8"))
+    state["artifacts"][0]["sha256"] = study.sha256_file(raw_path)
+    study.write_json_atomic(root / "status.json", state)
