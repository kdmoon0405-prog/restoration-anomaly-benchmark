+        for row in per_image:
+            q = quality_by_sample[row["sample"]]
+            psnr, ssim = ((q["psnr_bicubic"], q["ssim_bicubic"]) if query == "bicubic_x4"
+                          else (q["psnr_swinir"], q["ssim_swinir"]))
+            image_rows.append({**row, "category": category, "seed": 11,
+                "bank_domain": extension.BANK_DOMAIN, "query_domain": query,
+                "defect_type": sample_meta[row["sample"]].get("defect_type"), "psnr": psnr, "ssim": ssim})
+            prediction_rows.append({"bank_domain": extension.BANK_DOMAIN,
