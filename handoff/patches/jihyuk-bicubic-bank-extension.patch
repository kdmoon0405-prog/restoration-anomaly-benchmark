+"""Run one seed-11 normal Bicubic-bank extension on a full MVTec category."""
+from __future__ import annotations
+
+import argparse
+import gc
+import json
+import platform
+from pathlib import Path
+import shutil
+import sys
+import time
+import traceback
+
+import numpy as np
+from PIL import Image
+
+ROOT = Path(__file__).resolve().parents[1]
+sys.path.insert(0, str(ROOT))
+sys.path.insert(0, str(ROOT / "src"))
+
+from sr_anomaly.dataset import ImageSample, MVTecADFolder, safe_component
+from sr_anomaly.fusion import split_train_calibration
+from sr_anomaly.metrics import compute_quality_metrics
+from sr_anomaly.real_models import SwinIRLightweight
+from sr_anomaly import bank_domain_study as study
+from sr_anomaly import bicubic_bank_extension as extension
+from scripts import run_bank_domain_study as base
+from scripts import run_fusion_patchcore as branch_b
+
+IMAGE_SIZE = base.IMAGE_SIZE
+PATCHES_PER_IMAGE = base.PATCHES_PER_IMAGE
+EXECUTION_CODE_FILES = tuple(dict.fromkeys((
+    *base.EXECUTION_CODE_FILES,
+    "scripts/run_bicubic_bank_extension.py",
+    "src/sr_anomaly/bicubic_bank_extension.py",
+)))
+
+
+class _BicubicBankDataset:
+    """Normal fit images transformed by the already frozen x4 Bicubic query."""
+
+    def __init__(self, base_dataset, indices, resize, crop, transforms, torch):
+        self.base_dataset = base_dataset
+        self.indices = tuple(indices)
+        self.resize = resize
+        self.crop = crop
+        self.transforms = transforms
+        self.torch = torch
+
+    def __len__(self):
+        return len(self.indices)
+
+    def __getitem__(self, local_index):
+        source_index = self.indices[local_index]
+        classname, anomaly, image_path, _ = self.base_dataset.data_to_iterate[source_index]
+        with Image.open(image_path) as source:
+            clean = branch_b._canonical(source.convert("RGB"), self.resize, self.crop)
+        bicubic = extension.make_bicubic_x4_fit_image(clean, image_size=IMAGE_SIZE)
+        return {
+            "image": self.transforms(bicubic),
+            "mask": self.torch.zeros((1, IMAGE_SIZE, IMAGE_SIZE)),
+            "classname": classname,
+            "anomaly": anomaly,
+            "is_anomaly": 0,
+            "image_name": Path(image_path).as_posix(),
+            "image_path": str(image_path),
+        }
+
+
+def _query_manifest_sha(samples, input_hashes, query_hashes):
+    return base._canonical_sha256([
+        {
+            "sample": sample.relative_path.as_posix(),
+            "input_sha256": input_hashes[sample.relative_path.as_posix()],
+            "bicubic_x4_rgb_sha256": query_hashes[sample.relative_path.as_posix()]["bicubic_x4"],
+            "swinir_x4_rgb_sha256": query_hashes[sample.relative_path.as_posix()]["swinir_x4"],
+        }
+        for sample in samples
+    ])
+
+
+def _write_extension_manifest(run_dir: Path, *, status: str, evidence_kind: str,
+                              files: dict[str, str] | None = None) -> None:
+    study.write_json_atomic(run_dir / "bank_domain_extension_manifest.json", {
+        "schema_version": extension.SCHEMA_VERSION,
+        "kind": "bicubic_bank_extension_results",
+        "family": extension.EXTENSION_FAMILY,
+        "status": status,
+        "evidence_kind": evidence_kind,
+        "bank_domain": extension.BANK_DOMAIN,
+        "query_domains": list(extension.QUERY_DOMAINS),
+        "files": files or {},
+    })
+
+
+def _baseline_provenance(path: Path, category: str) -> tuple[dict, dict, dict]:
+    manifest = study.verify_result_contract(path)
+    config = json.loads((path / "config.json").read_text(encoding="utf-8"))
+    provenance = json.loads((path / "provenance.json").read_text(encoding="utf-8"))
+    status = json.loads((path / "status.json").read_text(encoding="utf-8"))
+    if (config.get("study_family") != "patchcore_full_patch_bank_domain_2x2"
+            or config.get("category") != category or config.get("seed") != 11
+            or status.get("status") != "COMPLETE"
+            or manifest.get("evidence_kind") != "model_predictions"):
+        raise ValueError("--baseline-run must be the complete model-prediction seed-11 2x2 run")
+    samples = status["test_samples"]
+    study.verify_complete_run(path, study.expected_condition_order(samples))
+    return config, provenance, status
+
+
+def run(args: argparse.Namespace) -> Path:
+    category = safe_component(args.category, "category").lower()
+    run_id = safe_component(args.run_id, "run id")
+    if category not in {"hazelnut", "screw"} or args.seed != 11:
+        raise ValueError("The frozen Bicubic-bank extension is limited to Hazelnut/Screw seed 11")
+    evidence_kind = "model_predictions"
+    data_root = args.data_root.resolve()
+    dataset_provenance = base._load_dataset_provenance(
+        args.dataset_provenance.resolve(), data_root, category
+    )
+    category_root = data_root / category
+    if not category_root.is_dir():
+        raise FileNotFoundError(f"Required MVTec category is missing: {category_root}")
+    baseline_path = args.baseline_run.resolve()
+    baseline_config, baseline_provenance, baseline_status = _baseline_provenance(
+        baseline_path, category
+    )
+
+    torch, transforms, InterpolationMode, backbones, common, patchcore, sampler, mvtec = branch_b._official_imports()
+    cuda_available = torch.cuda.is_available()
+    device = torch.device(branch_b.resolve_device(args.device, cuda_available))
+    if device.type != "cuda":
+        raise RuntimeError("This extension requires the existing CUDA device; CPU is only for fake tests")
+    checkpoint = args.swinir_checkpoint.resolve()
+    checkpoint_sha = branch_b._checksum(checkpoint)
+    if checkpoint_sha != base.EXPECTED_SWINIR_SHA256:
+        raise ValueError(f"SwinIR checkpoint SHA mismatch: {checkpoint_sha}")
+    backbone_checkpoint = args.backbone_checkpoint.resolve()
+    backbone_sha = branch_b._checksum(backbone_checkpoint)
+    if backbone_sha != base.EXPECTED_WIDERESNET_SHA256:
+        raise ValueError(f"WideResNet checkpoint SHA mismatch: {backbone_sha}")
+    actual_patchcore_commit = branch_b.subprocess.check_output(
+        ["git", "-C", str(branch_b.PATCHCORE_SOURCE.parent), "rev-parse", "HEAD"], text=True
+    ).strip()
+    if actual_patchcore_commit != base.EXPECTED_PATCHCORE_COMMIT:
+        raise RuntimeError("PatchCore vendored revision differs from the frozen study pin")
+
+    train_set = mvtec.MVTecDataset(
+        str(data_root), category, resize=256, imagesize=IMAGE_SIZE, split=mvtec.DatasetSplit.TRAIN
+    )
+    train_total = len(train_set)
+    fit_indices, calibration_indices = split_train_calibration(train_total, 0.8, args.seed)
+    if not fit_indices or not calibration_indices:
+        raise ValueError("Fit and normal calibration splits must both be nonempty")
+    if any(row[1] != "good" for row in train_set.data_to_iterate):
+        raise ValueError("Fit/calibration inputs must be normal train/good images only")
+    fit_paths = [Path(train_set.data_to_iterate[i][2]).relative_to(data_root).as_posix()
+                 for i in fit_indices]
+    calibration_paths = [Path(train_set.data_to_iterate[i][2]).relative_to(data_root).as_posix()
+                         for i in calibration_indices]
+    if set(fit_paths).intersection(calibration_paths):
+        raise ValueError("Fit and normal calibration parent images overlap")
+    calibration_samples = []
+    for index in calibration_indices:
+        image_path = Path(train_set.data_to_iterate[index][2])
+        relative = image_path.relative_to(data_root)
+        calibration_samples.append(ImageSample(
+            sample_id=relative.as_posix(), path=image_path, relative_path=relative,
+            mask_path=None,
+            metadata={"category": category, "split": "train", "label": 0, "defect_type": "good"},
+        ))
+    test_samples = MVTecADFolder(data_root, category, split="test", require_masks=True).samples()
+    if (not test_samples or any(s.mask_path and not s.mask_path.is_file() for s in test_samples)
+            or [s.relative_path.as_posix() for s in test_samples] != baseline_status["test_samples"]):
+        raise ValueError("Test parent inventory differs from the complete seed-11 baseline")
+
+    fit_plan = study.bank_fit_plan(len(fit_indices), batch_size=8)
+    available_ram = study.available_ram_bytes()
+    study.check_fit_ram(fit_plan, available_bytes=available_ram)
+    output_root = args.output_root.resolve()
+    output_root.mkdir(parents=True, exist_ok=True)
+    # Retain the existing 2x2 disk guard unchanged (conservative for this one-bank extension).
+    disk_plan = study.output_disk_plan(len(calibration_indices), len(test_samples), image_size=IMAGE_SIZE)
+    disk_free = shutil.disk_usage(output_root).free
+    study.check_output_disk(disk_plan, free_bytes=disk_free)
+    run_dir = output_root / run_id / category / f"seed{args.seed}"
+    if run_dir.exists():
+        raise FileExistsError(f"Extension output exists and will not be overwritten: {run_dir}")
+    run_dir.mkdir(parents=True, exist_ok=False)
+    state = {
+        "schema_version": extension.SCHEMA_VERSION,
+        "study_family": extension.EXTENSION_FAMILY,
+        "status": "BUILDING",
+        "scope": "seed-11-one-bank-two-query-extension",
+        "run_id": run_id,
+        "category": category,
+        "seed": args.seed,
+        "bank_domain": extension.BANK_DOMAIN,
+        "query_domains": list(extension.QUERY_DOMAINS),
+        "fit_paths": fit_paths,
+        "calibration_paths": calibration_paths,
+        "test_samples": [s.relative_path.as_posix() for s in test_samples],
+        "fit_count": len(fit_indices),
+        "calibration_count": len(calibration_indices),
+        "test_count": len(test_samples),
+        "evidence_kind": evidence_kind,
+        "baseline_run_id": baseline_config["protocol"].get("run_id") or baseline_provenance.get("run_id"),
+        "baseline_query_manifest_sha256": baseline_provenance["query_manifest_sha256"],
+        "dataset_provenance": dataset_provenance,
+        "resource_plan": {"fit_ram": fit_plan, "available_ram_before_run_bytes": available_ram,
+                          "prediction_disk": disk_plan, "free_disk_before_run_bytes": disk_free},
+        "artifacts": [],
+        "prediction_rows": [],
+    }
+    state["execution_source_sha256_snapshot"] = {
+        name: study.sha256_file(ROOT / name) for name in EXECUTION_CODE_FILES
+    }
+    state["source_commit"] = branch_b.subprocess.check_output(
+        ["git", "rev-parse", "HEAD"], cwd=ROOT, text=True
+    ).strip()
+    state["git_branch"] = branch_b.subprocess.check_output(
